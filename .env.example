# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model

# Optional, for reasoning models: "none" keeps replies ~1s and stops hidden
# reasoning from eating the output-token budget.
# LLM_REASONING_EFFORT=none

# Examples
#   OpenAI:        LLM_BASE_URL=https://api.openai.com/v1
#   Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
#   Local vLLM:    LLM_BASE_URL=http://localhost:8000/v1
